# Shared with the schools-facing app (fees101_schema.sql lives one level up)
# — this dashboard reads the same Supabase project, cross-school, via the
# service-role key. Get these values from the main app's .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# This app's own base URL, used to build Paystack callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Paystack — the PLATFORM's own account (Fees101 charging schools), separate
# from any school's own Paystack/Monnify credentials. Start with the sandbox
# test secret key already sitting unused in the main app's .env.local
# (PAYSTACK_TEST_SECRET_KEY) — same value works here. Swap to a live secret
# key only once real billing starts.
PAYSTACK_SECRET_KEY=

# Shared secret for the /api/cron/evaluate-billing route (scheduled
# suspension-ladder check) — same pattern as the main app's RECONCILE_SECRET.
# Any strong random string; put the same value in whatever scheduler calls it.
BILLING_CRON_SECRET=
